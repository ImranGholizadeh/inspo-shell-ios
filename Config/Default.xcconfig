// The shell's defaults: Inspo's own tally test on the sibling site. A customer
// lane builds with its own xcconfig (xcodebuild -xcconfig <lane>/deploy/ios.xcconfig),
// which sets these four; nothing of a customer is in this repository.
// (In an xcconfig // starts a comment, so a URL is written https:/$()/...)
INSPO_URL = https:/$()/client-inspo.web.app/tally
INSPO_APP_NAME = Inspo
INSPO_BUNDLE_ID = com.inspoui.shell
INSPO_URL_SCHEME = inspo
// A test build's stand-in for a native library (E42): the library's name
// (id-reader) puts StandInReader in its place; empty, none.
INSPO_NATIVE_STAND_IN =
// The Bluetooth ID scanner a customer build links (E47): the library's name
// in its urls (id-reader). Empty here: the vendor's package is never in this
// repository; a customer build compiles it with Bindings/ and sets this.
INSPO_ID_SCANNER =
